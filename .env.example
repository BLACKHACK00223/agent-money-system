# ===== KONE SERVICES - Variables d'environnement =====
# Copier ce fichier en .env et remplir les valeurs

# Clé secrète Django (obligatoire) - générer avec:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change_me_generer_une_cle_aleatoire

# Mode debug (False en production)
DJANGO_DEBUG=False

# Hôtes autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=.railway.app,localhost,127.0.0.1

# Base de données (laisser vide pour SQLite en local, Railway fournit DATABASE_URL)
DATABASE_URL=
